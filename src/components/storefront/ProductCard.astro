---
import { formatCLP } from '../../lib/formatters';
import type { Product } from '../../lib/catalog';

interface Props {
  product: Product;
  /** Permite aplicar un sutil desfase vertical estilo editorial en grillas de exploración. */
  staggered?: boolean;
}

const { product, staggered = false } = Astro.props;

const stockState =
  product.stock <= 0 ? 'out' : product.stock <= product.lowStockThreshold ? 'low' : 'ok';

const stockBadge = {
  out: { text: 'Agotado', dot: 'bg-stock-out', textClass: 'text-stock-out' },
  low: { text: `Últimas ${product.stock}`, dot: 'bg-stock-low', textClass: 'text-stock-low' },
  ok: { text: 'En stock', dot: 'bg-stock-ok', textClass: 'text-stock-ok' },
}[stockState];
---

<a
  href={`/producto/${product.slug}`}
  class:list={[
    'group flex flex-col focus:outline-none',
    staggered ? 'even:sm:translate-y-4' : '',
  ]}
>
  <!-- Contenedor suave de imagen estilo Soft UI -->
  <div
    class="relative aspect-[4/4.2] w-full overflow-hidden rounded-3xl bg-surface-muted transition-all duration-300 group-hover:bg-surface-hover group-focus-visible:ring-2 group-focus-visible:ring-lime-500"
  >
    {
      product.imageUrl ? (
        <img
          src={product.imageUrl}
          alt={product.name}
          width="400"
          height="420"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
      ) : (
        <span class="grid h-full w-full place-items-center text-5xl text-acero-400" aria-hidden="true">
          🏍️
        </span>
      )
    }

    <!-- Botón circular flotante esquina superior derecha (estilo imagen de referencia) -->
    <span
      class="absolute right-3 top-3 grid h-9 w-9 place-items-center rounded-full bg-white/95 text-carbon-900 shadow-xs transition-transform duration-200 group-hover:scale-110"
      aria-hidden="true"
    >
      {
        product.saleMode === 'WHATSAPP_ONLY' ? (
          <svg class="h-4 w-4 text-carbon-900" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
          </svg>
        ) : (
          <svg class="h-4 w-4 text-carbon-900" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M7 17 17 7" />
            <path d="M7 7h10v10" />
          </svg>
        )
      }
    </span>

    {
      product.saleMode === 'WHATSAPP_ONLY' && (
        <span class="absolute bottom-3 left-3 rounded-full bg-carbon-950/90 px-3 py-1 text-[11px] font-bold text-lime-500 backdrop-blur-xs">
          Cotización directa
        </span>
      )
    }
  </div>

  <!-- Información limpia debajo de la tarjeta -->
  <div class="mt-2.5 flex flex-1 flex-col px-1">
    <p class="truncate text-xs font-medium text-acero-500">
      {product.category ?? 'Repuesto'} · <span class="font-mono text-[11px]">{product.sku}</span>
    </p>

    <h3 class="mt-0.5 line-clamp-2 text-sm font-bold leading-snug text-carbon-900 sm:text-[15px]">
      {product.name}
    </h3>

    <div class="mt-1.5 flex items-center justify-between gap-2">
      <p class="text-base font-extrabold tracking-tight text-carbon-950 sm:text-lg">
        {formatCLP(product.priceClp)}
      </p>

      <span class={`inline-flex items-center gap-1.5 text-[11px] font-semibold ${stockBadge.textClass}`}>
        <span class={`h-1.5 w-1.5 rounded-full ${stockBadge.dot}`}></span>
        {stockBadge.text}
      </span>
    </div>
  </div>
</a>
