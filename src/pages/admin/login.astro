---
import '../../styles/global.css';
import AdminLogin from '../../components/admin/AdminLogin';

const storeName = import.meta.env.PUBLIC_STORE_NAME || 'Aldos Motos';
const logoUrl = 'https://res.cloudinary.com/do6bpao6a/image/upload/v1792446600/no_bg_ktqqew.webp';
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Ingresar · Panel {storeName}</title>
  </head>
  <body class="grid min-h-screen place-items-center bg-carbon-900 p-4 text-carbon-900 antialiased">
    <div class="w-full max-w-sm rounded-2xl bg-white p-6 shadow-2xl">
      <div class="text-center">
        <img
          src={logoUrl}
          alt={`Logo ${storeName}`}
          width="56"
          height="56"
          decoding="async"
          class="mx-auto h-14 w-14 object-contain"
        />
        <h1 class="mt-3 text-xl font-extrabold">Panel {storeName}</h1>
        <p class="mt-1 text-sm text-acero-500">Acceso exclusivo de administración</p>
      </div>

      <div class="mt-6">
        <AdminLogin client:load />
      </div>
    </div>
  </body>
</html>
