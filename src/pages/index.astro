---
import PublicLayout from '../layouts/PublicLayout.astro';
import ProductCard from '../components/storefront/ProductCard.astro';
import { CATEGORIES, getFeatured } from '../lib/catalog';
import { buildWhatsAppLink } from '../lib/whatsapp';

const { items: featured } = await getFeatured(8);

const storeName = import.meta.env.PUBLIC_STORE_NAME || 'Aldos Motos';
const whatsappLink = buildWhatsAppLink(
  undefined,
  'Hola, quiero hacer una consulta sobre un repuesto para mi moto.',
);

const categoryPills = [
  { href: '/catalogo', label: 'Todos', active: false },
  { href: '/catalogo?line=XR_CLASSIC', label: 'Línea XR', active: true, highlight: true },
  { href: '/catalogo?line=ENDURO', label: 'Enduro', active: false },
  ...CATEGORIES.map((c) => ({
    href: `/catalogo?category=${c.slug}`,
    label: c.name,
    active: false,
    highlight: false,
  })),
];

const lines = [
  {
    href: '/catalogo?line=XR_CLASSIC',
    tag: 'Clásicas Japonesas y Brasileñas',
    title: 'Línea Honda XR',
    text: 'Repuestos originales y alternativos probados para XR 125, 150, 190, 250R, Tornado, 400 y 600.',
    badge: 'Especialidad',
  },
  {
    href: '/catalogo?line=ENDURO',
    tag: 'Competición y Cerro',
    title: 'Línea Enduro & Cross',
    text: 'KTM EXC, Husqvarna, Yamaha WR/YZ, Honda CRF, Beta y GasGas listos para el barro.',
    badge: 'Alto Rendimiento',
  },
];
---

<PublicLayout
  title="Aldo's Motos — Repuestos y Accesorios para Motos | Envío a todo Chile"
  description="Repuestos y accesorios para motos Enduro y línea Honda XR. Despacho el mismo día a todo Chile. Asesoría técnica real por WhatsApp."
>
  <div class="mx-auto max-w-7xl px-4 pt-3">
    <!-- Hero Card Oscura con Aros Concéntricos en Verde Lima (estilo imagen de referencia) -->
    <section
      class="relative overflow-hidden rounded-3xl bg-carbon-950 px-6 py-8 text-white sm:px-10 sm:py-12"
    >
      <!-- Gráfico concéntrico decorativo (SVG 0 KB) -->
      <svg
        aria-hidden="true"
        class="pointer-events-none absolute -right-12 top-1/2 h-72 w-72 -translate-y-1/2 opacity-35 sm:right-6 sm:h-96 sm:w-96"
        viewBox="0 0 320 320"
        fill="none"
      >
        <circle cx="160" cy="160" r="145" stroke="#92E833" stroke-width="2" stroke-dasharray="14 10" />
        <circle cx="160" cy="160" r="115" stroke="#92E833" stroke-width="2" stroke-dasharray="22 12" />
        <circle cx="160" cy="160" r="85" stroke="#92E833" stroke-width="2.5" stroke-dasharray="10 8" />
        <circle cx="160" cy="160" r="55" stroke="#92E833" stroke-width="2" />
      </svg>

      <div class="relative z-10 max-w-xl">
        <span
          class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-lime-400 backdrop-blur-xs"
        >
          <span>✦</span> Taller Especialista · 20 años de experiencia
        </span>

        <h1 class="mt-3 text-2xl font-extrabold leading-tight tracking-tight sm:text-4xl lg:text-5xl">
          Repuestos Enduro
          <span class="block">
            & Línea <span class="text-lime-500">Honda XR</span>
          </span>
        </h1>

        <p class="mt-3 max-w-md text-xs leading-relaxed text-acero-300 sm:text-sm">
          Despacho en el mismo día de Arica a Punta Arenas e Isla de Pascua. Compatibilidad
          verificada por Aldo.
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a
            href="/catalogo"
            class="inline-flex items-center gap-2 rounded-full bg-lime-500 px-6 py-3 text-sm font-extrabold text-carbon-950 shadow-sm transition-transform hover:bg-lime-400 active:scale-95"
          >
            Explorar ahora
          </a>
          <a
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-5 py-3 text-sm font-semibold text-white backdrop-blur-xs transition-colors hover:bg-white/15"
          >
            Consultar a Aldo
          </a>
        </div>

        <!-- Indicadores estilo carrusel del banner de referencia -->
        <div class="mt-6 flex items-center gap-1.5" aria-hidden="true">
          <span class="h-1.5 w-6 rounded-full bg-lime-500"></span>
          <span class="h-1.5 w-1.5 rounded-full bg-white/30"></span>
          <span class="h-1.5 w-1.5 rounded-full bg-white/30"></span>
          <span class="h-1.5 w-1.5 rounded-full bg-white/30"></span>
        </div>
      </div>
    </section>

    <!-- Píldoras horizontales de categorías (Category Pills) -->
    <section aria-label="Categorías rápidas" class="mt-5">
      <ul class="no-scrollbar flex items-center gap-2.5 overflow-x-auto py-1">
        {
          categoryPills.map((pill) => (
            <li class="shrink-0">
              <a
                href={pill.href}
                class:list={[
                  'inline-flex items-center gap-1.5 rounded-full px-5 py-2.5 text-sm transition-all',
                  pill.active
                    ? 'bg-carbon-900 font-bold text-white shadow-xs'
                    : 'bg-surface-muted font-medium text-carbon-800 hover:bg-surface-hover',
                ]}
              >
                {pill.highlight && <span class="text-lime-500" aria-hidden="true">✦</span>}
                {pill.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Sección Destacados ("Especial para ti" / "Ver todo") -->
    <section class="mt-7">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-lg font-extrabold tracking-tight text-carbon-950 sm:text-xl">
          Especial para tu Moto
        </h2>
        <a
          href="/catalogo"
          class="text-sm font-semibold text-acero-500 transition-colors hover:text-carbon-900"
        >
          Ver todo
        </a>
      </div>

      <ul class="mt-4 grid grid-cols-2 gap-x-4 gap-y-6 sm:gap-x-5 sm:gap-y-8 md:grid-cols-3 lg:grid-cols-4">
        {featured.map((product) => <li><ProductCard product={product} /></li>)}
      </ul>
    </section>

    <!-- Líneas Estrella del Taller -->
    <section class="mt-12">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-lg font-extrabold tracking-tight text-carbon-950 sm:text-xl">
          Líneas Especializadas
        </h2>
      </div>

      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        {
          lines.map((line) => (
            <a
              href={line.href}
              class="group flex flex-col justify-between rounded-3xl bg-surface-muted p-6 transition-all hover:bg-surface-hover"
            >
              <div>
                <div class="flex items-center justify-between gap-2">
                  <span class="rounded-full bg-white px-3 py-1 text-[11px] font-bold text-carbon-900 shadow-2xs">
                    {line.badge}
                  </span>
                  <span class="grid h-9 w-9 place-items-center rounded-full bg-carbon-900 text-lime-500 transition-transform group-hover:translate-x-0.5">
                    →
                  </span>
                </div>
                <p class="mt-4 text-xs font-semibold text-acero-500">{line.tag}</p>
                <h3 class="mt-0.5 text-xl font-extrabold text-carbon-950">{line.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-acero-600">{line.text}</p>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Bloque de Confianza e Institucional -->
    <section class="mt-12">
      <div class="grid gap-4 rounded-3xl bg-carbon-950 p-6 text-white sm:grid-cols-3 lg:p-8">
        <div class="rounded-2xl bg-white/5 p-4">
          <span class="inline-grid h-10 w-10 place-items-center rounded-full bg-lime-500 text-lg text-carbon-950">
            🚚
          </span>
          <p class="mt-3 font-bold">Despacho el mismo día</p>
          <p class="mt-1 text-xs leading-relaxed text-acero-300">
            De Arica a Punta Arenas, incluida Isla de Pascua (Rapa Nui).
          </p>
        </div>

        <div class="rounded-2xl bg-white/5 p-4">
          <span class="inline-grid h-10 w-10 place-items-center rounded-full bg-lime-500 text-lg text-carbon-950">
            🔧
          </span>
          <p class="mt-3 font-bold">20 años de experiencia</p>
          <p class="mt-1 text-xs leading-relaxed text-acero-300">
            Asesoría técnica real de Aldo, mecánico especialista en XR y Enduro.
          </p>
        </div>

        <div class="rounded-2xl bg-white/5 p-4">
          <span class="inline-grid h-10 w-10 place-items-center rounded-full bg-lime-500 text-lg text-carbon-950">
            💬
          </span>
          <p class="mt-3 font-bold">Trato 100% humano</p>
          <p class="mt-1 text-xs leading-relaxed text-acero-300">
            Sin bots ni respuestas automáticas: te atiende una persona por WhatsApp.
          </p>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
        <a
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full bg-lime-500 px-6 py-3 text-sm font-extrabold text-carbon-950 transition-colors hover:bg-lime-400"
        >
          Consultar por WhatsApp
        </a>
        <a
          href="https://instagram.com"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full bg-surface-muted px-5 py-3 text-sm font-semibold text-carbon-900 hover:bg-surface-hover"
        >
          Instagram
        </a>
        <a
          href="https://facebook.com"
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full bg-surface-muted px-5 py-3 text-sm font-semibold text-carbon-900 hover:bg-surface-hover"
        >
          Facebook
        </a>
      </div>
      <p class="mt-3 text-center text-xs text-acero-500">
        {storeName} · Atención directa por WhatsApp de lunes a sábado.
      </p>
    </section>
  </div>
</PublicLayout>
