---
import PublicLayout from '../../layouts/PublicLayout.astro';
import OrderConfirmationSummary from '../../components/storefront/OrderConfirmationSummary';
import { buildWhatsAppLink } from '../../lib/whatsapp';
import { formatCLP } from '../../lib/formatters';

const params = Astro.url.searchParams;
const orderNumber = params.get('order') ?? '';
const trackingCode = params.get('code') ?? '';
const method = params.get('method') === 'BANK_TRANSFER' ? 'BANK_TRANSFER' : 'KHIPU';
const total = Number(params.get('total') ?? 0);
const customerName = params.get('name') ?? '';

const whatsappMessage = [
  `Hola, soy ${customerName || 'un cliente'}.`,
  orderNumber ? `Acabo de hacer el pedido #${orderNumber}.` : 'Acabo de hacer un pedido.',
  method === 'BANK_TRANSFER' ? 'Envío el comprobante de la transferencia.' : '',
].filter(Boolean).join(' ');

const whatsappUrl = buildWhatsAppLink(undefined, whatsappMessage);

const trackingUrl = trackingCode ? `/seguimiento?code=${encodeURIComponent(trackingCode)}` : '/seguimiento';
---

<PublicLayout
  title="Pedido confirmado | Gracias por tu compra"
  description="Tu pedido fue registrado correctamente. Revisa tu código de seguimiento y los datos de pago."
>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <div class="mx-auto max-w-3xl px-4 py-10">
    {
      !orderNumber ? (
        <div class="rounded-xl border border-dashed border-acero-300 p-10 text-center">
          <p class="text-4xl">🧾</p>
          <h1 class="mt-3 text-2xl font-extrabold">No encontramos tu pedido</h1>
          <p class="mt-2 text-sm text-acero-500">
            Si ya pagaste, revisa el correo de confirmación o escríbenos por WhatsApp.
          </p>
          <a
            href="/catalogo"
            class="mt-5 inline-block rounded-lg bg-competicion-500 px-6 py-3 text-sm font-bold text-white hover:bg-competicion-600"
          >
            Volver al catálogo
          </a>
        </div>
      ) : (
        <div class="space-y-6">
          <div class="rounded-3xl bg-carbon-950 p-6 text-center text-white">
            <span class="mx-auto inline-grid h-12 w-12 place-items-center rounded-full bg-lime-500 text-2xl text-carbon-950">
              ✓
            </span>
            <h1 class="mt-3 text-2xl font-extrabold">¡Gracias por tu compra!</h1>
            <p class="mt-1 text-sm text-acero-300">
              {customerName ? `${customerName}, ` : ''}tu pedido quedó registrado.
            </p>

            <div class="mt-5 grid gap-3 sm:grid-cols-2">
              <div class="rounded-xl bg-white/10 p-3">
                <p class="text-xs uppercase tracking-wide text-acero-300">N° de pedido</p>
                <p class="mt-1 font-mono text-lg font-bold">{orderNumber}</p>
              </div>
              <div class="rounded-xl bg-white/10 p-3">
                <p class="text-xs uppercase tracking-wide text-acero-300">Código de seguimiento</p>
                <p class="mt-1 font-mono text-lg font-bold">{trackingCode || '—'}</p>
              </div>
            </div>

            {total > 0 && (
              <p class="mt-4 text-sm text-acero-300">
                Total del pedido: <span class="text-lg font-bold text-white">{formatCLP(total)}</span>
              </p>
            )}
          </div>

          <OrderConfirmationSummary method={method} client:load />

          <div class="flex flex-col gap-3 sm:flex-row">
            <a
              href={trackingUrl}
              class="flex-1 rounded-full bg-carbon-950 px-5 py-3.5 text-center text-sm font-bold text-white hover:bg-carbon-800"
            >
              Seguir mi pedido
            </a>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 rounded-full bg-lime-500 px-5 py-3.5 text-center text-sm font-extrabold text-carbon-950 hover:bg-lime-400"
            >
              Escribir por WhatsApp
            </a>
            <a
              href="/catalogo"
              class="flex-1 rounded-full bg-surface-muted px-5 py-3.5 text-center text-sm font-semibold text-carbon-900 hover:bg-surface-hover"
            >
              Seguir comprando
            </a>
          </div>
        </div>
      )
    }
  </div>
</PublicLayout>
