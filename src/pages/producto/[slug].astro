---
import PublicLayout from '../../layouts/PublicLayout.astro';
import ProductActions from '../../components/storefront/ProductActions';
import { getProductBySlug, productImages } from '../../lib/catalog';
import {
  DISPATCH_CUTOFF_NOTE,
  ISLA_DE_PASCUA_NOTE,
  getShippingRates,
} from '../../lib/shipping';
import { formatCLP } from '../../lib/formatters';
import { buildWhatsAppLink } from '../../lib/whatsapp';

const slug = Astro.params.slug ?? '';
const product = slug ? await getProductBySlug(slug) : null;

if (!product) {
  Astro.response.status = 404;
}

const images = product ? productImages(product) : [];
const mainImage = images[0];
const compatibility = product?.compatibility ?? [];

const stockState = !product
  ? 'out'
  : product.stock <= 0
    ? 'out'
    : product.stock <= product.lowStockThreshold
      ? 'low'
      : 'ok';

const stockLabel = {
  out: '🔴 Agotado temporalmente',
  low: `🟠 ¡Últimas ${product?.stock ?? 0} unidades en bodega!`,
  ok: '🟢 En stock — Despacho hoy mismo',
}[stockState];

const productUrl = product
  ? new URL(`/producto/${product.slug}`, Astro.site ?? Astro.url).toString()
  : '';

const jsonLd = product
  ? {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: product.name,
      sku: product.sku,
      description: product.description ?? product.name,
      image: images.length > 0 ? images : undefined,
      brand: {
        '@type': 'Brand',
        name: compatibility[0]?.brand ?? 'Genérico',
      },
      offers: {
        '@type': 'Offer',
        priceCurrency: 'CLP',
        price: product.priceClp,
        availability:
          product.stock > 0 ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
        itemCondition:
          product.condition === 'USED'
            ? 'https://schema.org/UsedCondition'
            : 'https://schema.org/NewCondition',
        url: productUrl,
      },
    }
  : null;

const { rates } = await getShippingRates();

const islaDePascuaWhatsApp = buildWhatsAppLink(
  undefined,
  'Hola, quiero cotizar el despacho a Isla de Pascua (Rapa Nui).',
);
---

<PublicLayout
  title={product ? `${product.name} | Envío a todo Chile` : 'Producto no encontrado'}
  description={
    product
      ? `${product.name}. SKU ${product.sku}. ${product.description ?? ''} Despacho el mismo día a todo Chile.`
      : 'El producto que buscas no está disponible.'
  }
  canonical={product ? productUrl : undefined}
  ogType={product ? 'product' : 'website'}
  ogImage={product ? (mainImage ?? '/og-image.png') : undefined}
>
  {
    jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
      />
    )
  }

  {
    !product ? (
      <div class="mx-auto max-w-3xl px-4 py-20 text-center">
        <p class="text-4xl">🔎</p>
        <h1 class="mt-3 text-2xl font-extrabold">Producto no encontrado</h1>
        <p class="mt-2 text-sm text-acero-500">
          Puede que ya no esté disponible. Revisa el catálogo completo o consúltanos por WhatsApp.
        </p>
        <a
          href="/catalogo"
          class="mt-5 inline-block rounded-full bg-lime-500 px-6 py-3 text-sm font-extrabold text-carbon-950 hover:bg-lime-400"
        >
          Volver al catálogo
        </a>
      </div>
    ) : (
      <div class="mx-auto max-w-7xl px-4 py-5">
        <nav aria-label="Ruta de navegación" class="flex flex-wrap items-center gap-1.5 text-xs text-acero-500">
          <a href="/" class="hover:text-carbon-900">Inicio</a>
          <span>/</span>
          <a href="/catalogo" class="hover:text-carbon-900">Catálogo</a>
          {product.category && (
            <>
              <span>/</span>
              <a
                href={`/catalogo?category=${product.categorySlug ?? ''}`}
                class="hover:text-carbon-900"
              >
                {product.category}
              </a>
            </>
          )}
          <span>/</span>
          <span class="font-medium text-carbon-900">{product.name}</span>
        </nav>

        <div class="mt-5 grid gap-8 lg:grid-cols-2">
          <!-- Galería en contenedor Soft UI -->
          <div>
            <div class="overflow-hidden rounded-3xl bg-surface-muted">
              {mainImage ? (
                <img
                  src={mainImage}
                  alt={product.name}
                  width="800"
                  height="800"
                  fetchpriority="high"
                  decoding="async"
                  class="aspect-square h-auto w-full object-cover"
                />
              ) : (
                <div class="grid aspect-square w-full place-items-center text-7xl text-acero-400" aria-hidden="true">
                  🏍️
                </div>
              )}
            </div>
            {images.length > 1 && (
              <ul class="mt-3 grid grid-cols-5 gap-2.5">
                {images.map((image) => (
                  <li>
                    <img
                      src={image}
                      alt={product.name}
                      width="120"
                      height="120"
                      loading="lazy"
                      decoding="async"
                      class="aspect-square w-full rounded-2xl bg-surface-muted object-cover"
                    />
                  </li>
                ))}
              </ul>
            )}
          </div>

          <!-- Información y acciones -->
          <div class="flex flex-col justify-center">
            <div class="flex flex-wrap items-center gap-2">
              <span class="rounded-full bg-surface-muted px-3 py-1 text-xs font-bold text-carbon-900">
                {product.category ?? 'Repuesto'}
              </span>
              <span class="rounded-full bg-surface-muted px-3 py-1 text-xs font-semibold text-acero-600">
                {product.condition === 'USED' ? 'Usado revisado' : 'Nuevo'}
              </span>
            </div>

            <h1 class="mt-3 text-2xl font-extrabold leading-tight tracking-tight text-carbon-950 lg:text-3xl">
              {product.name}
            </h1>

            <p class="mt-2 text-xs text-acero-500 sm:text-sm">
              SKU: <span class="font-mono font-semibold text-carbon-900">{product.sku}</span>
              {product.oemPartNumber && (
                <> · N° de parte OEM: <span class="font-mono font-semibold text-carbon-900">{product.oemPartNumber}</span></>
              )}
            </p>

            <div class="mt-5 flex flex-wrap items-baseline gap-3">
              <p class="text-3xl font-extrabold tracking-tight text-carbon-950">{formatCLP(product.priceClp)}</p>
              <p
                class:list={[
                  'rounded-full px-3 py-1 text-xs font-bold',
                  stockState === 'ok'
                    ? 'bg-stock-ok/10 text-stock-ok'
                    : stockState === 'low'
                      ? 'bg-stock-low/10 text-stock-low'
                      : 'bg-stock-out/10 text-stock-out',
                ]}
              >
                {stockLabel}
              </p>
            </div>

            <div class="mt-6">
              <ProductActions
                client:load
                productId={product.id}
                sku={product.sku}
                name={product.name}
                slug={product.slug}
                priceClp={product.priceClp}
                stock={product.stock}
                saleMode={product.saleMode}
                oemPartNumber={product.oemPartNumber ?? null}
                productUrl={productUrl}
              />
            </div>

            {product.description && (
              <div class="mt-7 rounded-3xl bg-surface-muted p-5">
                <h2 class="text-xs font-bold uppercase tracking-wider text-acero-600">Detalle técnico</h2>
                <p class="mt-2 text-sm leading-relaxed text-carbon-900">{product.description}</p>
              </div>
            )}
          </div>
        </div>

        <!-- Motos compatibles -->
        <section class="mt-12">
          <h2 class="text-xl font-extrabold tracking-tight text-carbon-950">Motos compatibles</h2>
          {compatibility.length > 0 ? (
            <div class="mt-4 overflow-x-auto rounded-3xl bg-surface-muted p-2">
              <table class="w-full text-left text-sm">
                <thead class="text-xs uppercase tracking-wide text-acero-500">
                  <tr>
                    <th class="px-4 py-3">Marca</th>
                    <th class="px-4 py-3">Modelo</th>
                    <th class="px-4 py-3">Años</th>
                    <th class="px-4 py-3">Nota técnica</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-acero-200/70 rounded-2xl bg-white">
                  {compatibility.map((entry) => (
                    <tr>
                      <td class="px-4 py-3 font-bold text-carbon-900">{entry.brand}</td>
                      <td class="px-4 py-3 font-medium">{entry.model}</td>
                      <td class="px-4 py-3 text-acero-600">
                        {entry.yearFrom || entry.yearTo
                          ? `${entry.yearFrom ?? ''} – ${entry.yearTo ?? 'actual'}`
                          : 'Todos'}
                      </td>
                      <td class="px-4 py-3 text-acero-600">{entry.fitmentNotes ?? '—'}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : product.isUniversal ? (
            <p class="mt-3 rounded-2xl bg-lime-500/20 px-4 py-3 text-sm font-semibold text-carbon-900">
              ✓ Producto universal: compatible con la mayoría de las motocicletas.
            </p>
          ) : (
            <p class="mt-2 text-sm text-acero-500">
              Consúltanos por WhatsApp para confirmar compatibilidad con tu modelo exacto.
            </p>
          )}
        </section>

        <!-- Información de envío -->
        <section class="mt-8">
          <details class="rounded-3xl bg-surface-muted p-5">
            <summary class="cursor-pointer text-base font-extrabold text-carbon-950">
              Información de envío a todo Chile
            </summary>
            <p class="mt-2 text-sm text-acero-500">
              {DISPATCH_CUTOFF_NOTE} Costos referenciales por región; el valor final se confirma en el
              checkout.
            </p>
            <div class="mt-4 overflow-x-auto rounded-2xl bg-white p-2">
              <table class="w-full text-left text-sm">
                <thead class="text-xs uppercase tracking-wide text-acero-500">
                  <tr>
                    <th class="px-3 py-2">Región</th>
                    <th class="px-3 py-2">Costo</th>
                    <th class="px-3 py-2">Plazo estimado</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-acero-200/60">
                  {rates.map((rate) => (
                    <tr>
                      <td class="px-3 py-2.5">{rate.regionName}</td>
                      <td class="px-3 py-2.5 font-bold">
                        {rate.baseCostClp === 0 ? 'Por pagar en destino' : formatCLP(rate.baseCostClp)}
                      </td>
                      <td class="px-3 py-2.5 text-acero-600">{rate.estimatedDays}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="mt-3 text-xs text-acero-600">
              {ISLA_DE_PASCUA_NOTE}{' '}
              <a
                href={islaDePascuaWhatsApp}
                target="_blank"
                rel="noopener noreferrer"
                class="font-bold text-carbon-950 underline"
              >
                Cotizar por WhatsApp
              </a>
            </p>
          </details>
        </section>
      </div>
    )
  }
</PublicLayout>
